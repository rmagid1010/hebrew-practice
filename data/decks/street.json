{
  "items": [
    { "id": "sababa", "he": "סַבָּבָה", "alt": ["סבבא"], "en": "cool / OK / fine by me", "reg": "slang",
      "note": "The all-purpose 'OK, cool'. Borrowed from Arabic. You can answer almost any plan or question with it.",
      "ex": [["נִיפָּגֵשׁ בְּשֶׁבַע? — סַבָּבָה.", "Meet at seven? — Cool."], ["הַכּוֹל סַבָּבָה?", "Everything OK?"]] },
    { "id": "yalla", "he": "יַאלְלָה", "alt": ["יאלה"], "en": "come on / let's go / OK then", "reg": "slang",
      "note": "Hurrying someone, agreeing to a plan, or wrapping up. 'יאללה ביי' is how half of all phone calls end.",
      "ex": [["יַאלְלָה, מְאַחֲרִים!", "Come on, we're late!"], ["יַאלְלָה בַּיי.", "OK, bye."]] },
    { "id": "achla", "he": "אַחְלָה", "en": "great / excellent", "reg": "slang",
      "note": "Use it on its own ('אחלה!') or before a noun: אחלה מקום = a great place. It never changes for gender or number.",
      "ex": [["אַחְלָה מָקוֹם, לֹא?", "Great place, right?"], ["— אֲנִי מֵבִיא בִּירוֹת. — אַחְלָה!", "— I'm bringing beers. — Excellent!"]] },
    { "id": "walla", "he": "וַאלְלָה", "alt": ["ואלה"], "en": "really? / wow / honestly", "reg": "slang",
      "note": "As a question it means 'really?'. As a statement it adds 'honestly / I swear': וואלה, אתה צודק.",
      "ex": [["וַאלְלָה? לֹא יָדַעְתִּי.", "Really? I didn't know."], ["וַאלְלָה, אַתָּה צוֹדֵק.", "Honestly, you're right."]] },
    { "id": "tachles", "he": "תַּכְלֶס", "en": "bottom line / basically / let's be real", "reg": "slang",
      "note": "Cuts to the point. Also 'בתכלס' = in practice / actually.",
      "ex": [["תַּכְלֶס, אֵין לָנוּ זְמַן.", "Bottom line, we don't have time."], ["מָה הוּא רוֹצֶה תַּכְלֶס?", "What does he actually want?"]] },
    { "id": "stam", "he": "סְתָם", "en": "just kidding / for no reason / just", "reg": "casual",
      "note": "'סתם!' = just kidding. 'סתם ככה' = for no reason. 'סתם שאלה' = just a random question.",
      "ex": [["סְתָם, אֲנִי צוֹחֵק.", "Just kidding."], ["לָמָּה? — סְתָם.", "Why? — No reason."]] },
    { "id": "bektana", "he": "בִּקְטַנָּה", "en": "no big deal / it's nothing", "reg": "slang",
      "note": "Lit. 'in small'. The reply to 'thanks', or a way to say 'relax, don't make it a big thing'.",
      "ex": [["תּוֹדָה עַל הָעֶזְרָה! — בִּקְטַנָּה.", "Thanks for the help! — No big deal."]] },
    { "id": "ein-matzav", "he": "אֵין מַצָּב", "en": "no way!", "reg": "slang",
      "note": "Both disbelief ('no way, really?') and refusal ('no way am I doing that'). Lit. 'there's no situation'.",
      "ex": [["אֵין מַצָּב! בֶּאֱמֶת?", "No way! Really?"], ["אֵין מַצָּב שֶׁאֲנִי מְשַׁלֵּם עַל זֶה.", "No way I'm paying for that."]] },
    { "id": "haval-al-hazman", "he": "חֲבָל עַל הַזְּמַן", "en": "amazing! (lit. a waste of time)", "reg": "slang",
      "note": "Confusingly, in slang this is high praise: 'it's so good, it's a shame to waste time describing it'. It can also literally mean 'a waste of time' — context decides.",
      "ex": [["הַהוֹפָעָה הָיְיתָה חֲבָל עַל הַזְּמַן!", "The show was amazing!"]] },
    { "id": "al-hapanim", "he": "עַל הַפָּנִים", "en": "terrible / awful", "reg": "slang",
      "note": "Lit. 'on the face' (as in fell flat on its face).",
      "ex": [["אֵיךְ הָיָה הַסֶּרֶט? — עַל הַפָּנִים.", "How was the movie? — Awful."]] },
    { "id": "basa", "he": "בַּאסָה", "alt": ["באסא"], "en": "bummer / what a drag", "reg": "slang",
      "note": "Also as an adjective-ish phrase: 'איזה באסה' = what a bummer. 'מבואס' = bummed out.",
      "ex": [["אֵיזוֹ בַּאסָה, זֶה סָגוּר.", "What a bummer, it's closed."]] },
    { "id": "fadicha", "he": "פַדִּיחָה", "en": "embarrassing! / an embarrassment", "reg": "slang",
      "note": "Pronounced 'fadícha'. From Arabic. 'איזה פדיחות' = how embarrassing.",
      "ex": [["שָׁכַחְתִּי אֶת הָאַרְנָק. אֵיזוֹ פַדִּיחָה!", "I forgot my wallet. How embarrassing!"]] },
    { "id": "charta", "he": "חַרְטָא", "en": "nonsense / BS", "reg": "slang",
      "note": "A bit rude, fine among friends. Don't confuse with חרטה (regret).",
      "ex": [["זֶה סְתָם חַרְטָא.", "That's just nonsense."]] },
    { "id": "kapara", "he": "כַּפָּרָה עָלֶיךָ", "alt": ["כפרה"], "en": "you're the best / love you", "reg": "slang", "hint": "(to a man — the spelling is the same for a woman)",
      "note": "Lit. 'atonement upon you'. Affectionate, very Israeli; often just 'כפרה'. To a woman it's pronounced 'alayich' but spelled the same: עלייך / עליך.",
      "ex": [["תּוֹדָה, כַּפָּרָה עָלֶיךָ!", "Thanks, you're the best!"]] },
    { "id": "chalas", "he": "חַלַאס", "en": "enough already! / stop it!", "reg": "slang",
      "note": "From Arabic. Exasperated: 'חלאס, די!'",
      "ex": [["חַלַאס עִם הַטֶּלֶפוֹן!", "Enough with the phone already!"]] },
    { "id": "dai", "he": "דַּי", "en": "enough / quite, pretty", "reg": "casual",
      "note": "'די!' = stop! — but 'די טוב' = pretty good.",
      "ex": [["דַּי, נוּ!", "Stop it, come on!"], ["זֶה דַּי טוֹב.", "It's pretty good."]] },
    { "id": "nu", "he": "נוּ", "en": "come on / well? / so?", "reg": "casual",
      "note": "Impatience in one syllable. 'נו?' = well, what happened?",
      "ex": [["נוּ, מָה הוּא אָמַר?", "So? What did he say?"]] },
    { "id": "ma-nishma", "he": "מָה נִשְׁמָע?", "en": "what's up? / how's it going?", "reg": "casual",
      "note": "Lit. 'what's heard?'. The standard greeting. Answer: 'הכול טוב' or 'בסדר'.",
      "ex": [["הַיי, מָה נִשְׁמָע? — הַכּוֹל טוֹב, וְאַתָּה?", "Hey, what's up? — All good, and you?"]] },
    { "id": "ma-kore", "he": "מָה קוֹרֶה?", "en": "what's happening?", "reg": "casual",
      "ex": [["מָה קוֹרֶה, אָחִי?", "What's happening, bro?"]] },
    { "id": "ma-hainyanim", "he": "מָה הָעִנְיָינִים?", "alt": ["מה העניינים", "מה הענינים"], "en": "how are things?", "reg": "casual",
      "note": "Lit. 'what are the matters?'. Friendly and very common.", "ex": [] },
    { "id": "hakol-tov", "he": "הַכּוֹל טוֹב", "alt": ["הכל טוב"], "en": "all good / everything's fine", "reg": "casual",
      "note": "Spelled הכול (official) or הכל (very common). Both are accepted.",
      "ex": [["הַכּוֹל טוֹב, תּוֹדָה.", "All good, thanks."]] },
    { "id": "beseder", "he": "בְּסֵדֶר", "en": "OK / fine / alright", "reg": "neutral",
      "note": "Lit. 'in order'. 'בסדר גמור' = totally fine.",
      "ex": [["זֶה בְּסֵדֶר?", "Is that OK?"]] },
    { "id": "ein-baaya", "he": "אֵין בְּעָיָה", "en": "no problem", "reg": "casual",
      "ex": [["אֶפְשָׁר לָשֶׁבֶת פֹּה? — אֵין בְּעָיָה.", "Can I sit here? — No problem."]] },
    { "id": "ein-li-musag", "he": "אֵין לִי מוּשָּׂג", "en": "I have no idea", "reg": "casual",
      "ex": [["אֵין לִי מוּשָּׂג אֵיפֹה זֶה.", "I have no idea where that is."]] },
    { "id": "lo-meshane", "he": "לֹא מְשַׁנֶּה", "en": "never mind / doesn't matter", "reg": "casual",
      "ex": [["מָה אָמַרְתָּ? — לֹא מְשַׁנֶּה.", "What did you say? — Never mind."]] },
    { "id": "azov", "he": "עֲזוֹב", "alt": ["עזבי"], "en": "forget it / leave it", "reg": "casual", "hint": "(to a man)",
      "note": "The imperative of 'to leave'. To a woman: עִזְבִי. 'עזוב אותך' = forget about it.",
      "ex": [["עֲזוֹב, לֹא חָשׁוּב.", "Forget it, it's not important."]] },
    { "id": "ma-pitom", "he": "מָה פִּתְאוֹם!", "en": "no way! / what are you talking about!", "reg": "casual",
      "note": "A strong denial: lit. 'what, suddenly?'. 'אתה כועס? — מה פתאום!' = Are you angry? — Of course not!",
      "ex": [["אַתָּה כּוֹעֵס? — מָה פִּתְאוֹם!", "Are you angry? — Of course not!"]] },
    { "id": "bekef", "he": "בְּכֵיף", "en": "with pleasure / happily", "reg": "casual",
      "note": "From כיף (fun). The friendly reply to 'thank you'.",
      "ex": [["תּוֹדָה! — בְּכֵיף.", "Thanks! — My pleasure."]] },
    { "id": "bediyuk", "he": "בְּדִיּוּק", "en": "exactly", "reg": "neutral",
      "ex": [["בְּדִיּוּק מָה שֶׁרָצִיתִי.", "Exactly what I wanted."]] },
    { "id": "barur", "he": "בָּרוּר", "en": "obviously / of course", "reg": "casual",
      "ex": [["אַתָּה בָּא? — בָּרוּר!", "Are you coming? — Of course!"]] },
    { "id": "legamrei", "he": "לְגַמְרֵי", "en": "totally / completely", "reg": "casual",
      "ex": [["לְגַמְרֵי שָׁכַחְתִּי.", "I totally forgot."]] },
    { "id": "mamash", "he": "מַמָּשׁ", "en": "really / very", "reg": "casual",
      "note": "Spoken intensifier: ממש טוב = really good. 'ממש?' = really?",
      "ex": [["זֶה מַמָּשׁ טָעִים.", "It's really tasty."]] },
    { "id": "shave", "he": "שָׁוֶוה", "en": "worth it", "reg": "casual",
      "ex": [["זֶה שָׁוֶוה אֶת זֶה.", "It's worth it."], ["לֹא שָׁוֶוה.", "Not worth it."]] },
    { "id": "magniv", "he": "מַגְנִיב", "en": "cool", "reg": "casual",
      "ex": [["אֵיזֶה מַגְנִיב!", "How cool!"]] },
    { "id": "esh", "he": "אֵשׁ", "en": "fire / awesome", "reg": "slang",
      "note": "Literally 'fire'. Newer slang for something great.",
      "ex": [["הַמָּנָה הַזֹּאת אֵשׁ.", "This dish is fire."]] },
    { "id": "chaval", "he": "חֲבָל", "en": "too bad / what a shame", "reg": "neutral",
      "ex": [["חֲבָל שֶׁלֹּא בָּאתָ.", "Too bad you didn't come."]] },
    { "id": "achi", "he": "אָחִי", "en": "bro / dude (lit. my brother)", "reg": "slang",
      "note": "Said to any guy, even strangers. To a woman: אחותי (my sister) or מאמי.",
      "ex": [["תּוֹדָה, אָחִי.", "Thanks, bro."]] },
    { "id": "kaili", "he": "כְּאִילּוּ", "en": "like (filler) / as if", "reg": "casual",
      "note": "Exactly like English 'like'. 'כאילו מה?' = like, what do you mean?",
      "ex": [["הוּא, כְּאִילּוּ, לֹא הֵבִין כְּלוּם.", "He, like, didn't understand anything."]] },
    { "id": "zehu", "he": "זֶהוּ", "en": "that's it / that's all", "reg": "casual",
      "ex": [["זֶהוּ? — זֶהוּ.", "That's it? — That's it."]] },
    { "id": "rega", "he": "רֶגַע", "en": "wait a sec (lit. moment)", "reg": "casual",
      "ex": [["רֶגַע, מָה?", "Wait, what?"]] },
    { "id": "beemet", "he": "בֶּאֱמֶת?", "en": "really?", "reg": "neutral",
      "ex": [["בֶּאֱמֶת? לֹא יָדַעְתִּי.", "Really? I didn't know."]] },
    { "id": "yofi", "he": "יוֹפִי", "en": "great / nice (lit. beauty)", "reg": "casual",
      "ex": [["יוֹפִי, אָז נִתְרָאֶה מָחָר.", "Great, so see you tomorrow."]] },
    { "id": "balagan", "he": "בָּלָגָן", "en": "mess / chaos", "reg": "casual",
      "ex": [["אֵיזֶה בָּלָגָן!", "What a mess!"]] },
    { "id": "titchadesh", "he": "תִּתְחַדֵּשׁ", "alt": ["תתחדשי", "תתחדשו"], "en": "enjoy your new thing!", "reg": "casual", "hint": "(to a man)",
      "note": "Said whenever someone has something new — clothes, phone, haircut. To a woman: תִּתְחַדְּשִׁי.",
      "ex": [["נַעֲלַיִים חֲדָשׁוֹת? תִּתְחַדֵּשׁ!", "New shoes? Enjoy them!"]] },
    { "id": "yesh", "he": "יֵשׁ!", "en": "yes!! (celebrating)", "reg": "casual",
      "note": "Lit. 'there is'. The fist-pump word.", "ex": [] },
    { "id": "uf", "he": "אוּף", "en": "ugh", "reg": "casual",
      "ex": [["אוּף, שׁוּב פְּקָק.", "Ugh, traffic again."]] },
    { "id": "habibi", "he": "חַבִּיבִּי", "en": "buddy / dear", "reg": "slang",
      "note": "From Arabic 'my dear'. Warm, joking, between friends.", "ex": [] },
    { "id": "leat-leat", "he": "לְאַט לְאַט", "en": "slowly, step by step / take it easy", "reg": "neutral",
      "ex": [["לְאַט לְאַט, אַתָּה תִּלְמַד.", "Bit by bit, you'll learn."]] },
    { "id": "sagur", "he": "סָגוּר", "en": "closed / it's a deal", "reg": "casual",
      "note": "Besides 'closed', it means 'settled, deal': 'סגור?' — 'סגור.' = Deal? — Deal.",
      "ex": [["אָז בִּשְׁמוֹנֶה, סָגוּר?", "So at eight, deal?"]] }
  ]
}
