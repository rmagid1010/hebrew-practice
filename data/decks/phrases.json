    { "id": "p03", "he": "אַתָּה יָכוֹל לְדַבֵּר לְאַט, בְּבַקָּשָׁה?", "alt": ["את יכולה לדבר לאט בבקשה", "אפשר לדבר לאט בבקשה"], "en": "Can you speak slowly, please?", "hint": "(to a man)", "reg": "neutral" },
